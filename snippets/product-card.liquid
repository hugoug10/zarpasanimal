{%- comment -%}
  Usage: {% render 'product-card', product: product %}
{%- endcomment -%}

{%- liquid
  assign img      = product.featured_image
  assign img2     = product.images[1]
  assign badge    = ''
  assign badge_cls = ''
  if product.tags contains 'bestseller'
    assign badge     = 'Más vendido'
    assign badge_cls = 'badge-best'
  elsif product.tags contains 'nuevo'
    assign badge     = 'Nuevo'
    assign badge_cls = 'badge-new'
  endif
-%}

<article class="product-card">
  <a href="{{ product.url }}" class="product-card__media" aria-label="{{ product.title }}">

    {% if badge != '' %}
      <span class="product-card__badge {{ badge_cls }}" aria-label="{{ badge }}">{{ badge }}</span>
    {% endif %}

    {% if img %}
      <img
        class="product-card__img"
        src="{{ img | img_url: '600x750' }}"
        srcset="{{ img | img_url: '400x500' }} 400w, {{ img | img_url: '600x750' }} 600w"
        sizes="(max-width:480px) 50vw, (max-width:1024px) 33vw, 25vw"
        alt="{{ img.alt | default: product.title }}"
        loading="lazy"
        width="600" height="750"
      >
    {% endif %}

    {% if img2 %}
      <img
        class="product-card__img-alt"
        src="{{ img2 | img_url: '600x750' }}"
        alt="{{ img2.alt | default: product.title }}"
        loading="lazy"
        width="600" height="750"
        aria-hidden="true"
      >
    {% endif %}

    <div class="product-card__quick" aria-hidden="true">Ver producto</div>

  </a>

  <div class="product-card__info">
    <p class="product-card__name">{{ product.title }}</p>

    {% if product.metafields.reviews.rating.value %}
      <div class="product-card__stars" aria-label="Valoración {{ product.metafields.reviews.rating.value }}">
        {% for i in (1..5) %}
          <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
        {% endfor %}
      </div>
    {% endif %}

    <p class="product-card__price">
      {{ product.price | money }}
      {% if product.compare_at_price > product.price %}
        <span class="product-card__compare">{{ product.compare_at_price | money }}</span>
      {% endif %}
    </p>
  </div>
</article>
