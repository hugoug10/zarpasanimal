<div class="cart-drawer" id="cart-drawer" role="dialog" aria-label="Carrito" aria-modal="true" aria-hidden="true">

  <div class="cart-drawer__head">
    <div style="display:flex;align-items:center;">
      <span class="cart-drawer__title">Tu carrito</span>
      <span class="cart-drawer__count" data-cart-count aria-live="polite">{{ cart.item_count }}</span>
    </div>
    <button class="icon-btn" data-cart-close aria-label="Cerrar carrito">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <div class="cart-drawer__items" id="cart-items" aria-live="polite">
    {% if cart.item_count == 0 %}
      <div class="cart-empty">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 01-8 0"/>
        </svg>
        <p>Tu carrito está vacío.</p>
        <a href="/collections/all" class="btn btn-primary" data-cart-close>Ver la colección</a>
      </div>
    {% else %}
      {% for item in cart.items %}
        <div class="cart-item" data-line="{{ forloop.index }}">
          <a href="{{ item.url }}">
            <img class="cart-item__img" src="{{ item.image | img_url: '160x160', crop: 'center' }}" alt="{{ item.title }}" loading="lazy" width="80" height="80">
          </a>
          <div class="cart-item__info">
            <a href="{{ item.url }}" class="cart-item__name">{{ item.product.title }}</a>
            {% unless item.variant.title == 'Default Title' %}
              <p class="cart-item__variant">{{ item.variant.title }}</p>
            {% endunless %}
            {% for p in item.properties %}
              {% unless p.last == blank %}
                <p class="cart-item__variant">{{ p.first }}: {{ p.last }}</p>
              {% endunless %}
            {% endfor %}
            <div class="cart-item__row">
              <div class="qty-wrap" data-line="{{ forloop.index }}">
                <button class="qty-btn" data-action="minus" aria-label="Restar">−</button>
                <span class="qty-val">{{ item.quantity }}</span>
                <button class="qty-btn" data-action="plus" aria-label="Sumar">+</button>
              </div>
              <div style="text-align:right;">
                <p class="cart-item__price">{{ item.line_price | money }}</p>
                <button class="cart-item__remove" data-line="{{ forloop.index }}">Eliminar</button>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>

  <div id="cart-foot" style="{% if cart.item_count == 0 %}display:none;{% endif %}">
    <div class="cart-drawer__foot">
      <div class="cart-subtotal">
        <span class="cart-subtotal__label">Subtotal</span>
        <span class="cart-subtotal__price" id="cart-total">{{ cart.total_price | money }}</span>
      </div>
      <p class="cart-shipping" id="cart-ship-msg">
        {% if cart.total_price >= 4900 %}
          ✓ ¡Envío gratis aplicado!
        {% else %}
          Te faltan {{ 4900 | minus: cart.total_price | money }} para envío gratis
        {% endif %}
      </p>
      <a href="/checkout" class="btn btn-primary cart-checkout" data-magnetic>
        Finalizar compra →
      </a>
      <div style="display:flex;justify-content:center;gap:8px;opacity:.35;filter:grayscale(1);margin-top:4px;" aria-label="Métodos de pago aceptados">
        <svg width="34" height="22" viewBox="0 0 34 22" fill="none"><rect width="34" height="22" rx="3" fill="#E8E0D4"/><text x="17" y="15" text-anchor="middle" font-size="8" fill="#8C8278" font-family="sans-serif">VISA</text></svg>
        <svg width="34" height="22" viewBox="0 0 34 22" fill="none"><rect width="34" height="22" rx="3" fill="#E8E0D4"/><text x="17" y="15" text-anchor="middle" font-size="8" fill="#8C8278" font-family="sans-serif">MC</text></svg>
        <svg width="34" height="22" viewBox="0 0 34 22" fill="none"><rect width="34" height="22" rx="3" fill="#E8E0D4"/><text x="17" y="15" text-anchor="middle" font-size="8" fill="#8C8278" font-family="sans-serif">PayPal</text></svg>
      </div>
    </div>
  </div>

</div>
