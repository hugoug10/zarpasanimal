<div class="trust-bar">
  <div class="trust-bar__inner">
    {% for block in section.blocks %}
      <div class="trust-item" {{ block.shopify_attributes }}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {% case block.settings.icon %}
            {% when 'shipping' %}<path d="M5 17H3a2 2 0 01-2-2V5a2 2 0 012-2h11a2 2 0 012 2v3"/><rect x="9" y="11" width="14" height="10" rx="2"/><circle cx="12" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
            {% when 'clock'    %}<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            {% when 'return'   %}<path d="M3 12a9 9 0 109-9 9.75 9.75 0 00-6.74 2.74L3 8"/><path d="M3 3v5h5"/>
            {% when 'shield'   %}<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            {% else            %}<polyline points="20 6 9 17 4 12"/>
          {% endcase %}
        </svg>
        <span>{{ block.settings.text }}</span>
      </div>
      {% unless forloop.last %}<div class="trust-sep" aria-hidden="true"></div>{% endunless %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Trust Bar",
  "blocks": [{
    "type": "item", "name": "Item",
    "settings": [
      { "type": "select", "id": "icon", "label": "Icono",
        "options": [
          { "value": "shipping", "label": "Envío" },
          { "value": "clock",    "label": "Reloj" },
          { "value": "return",   "label": "Devolución" },
          { "value": "shield",   "label": "Escudo" },
          { "value": "check",    "label": "Check" }
        ], "default": "check" },
      { "type": "text", "id": "text", "label": "Texto", "default": "Envío gratis +€49" }
    ]
  }],
  "presets": [{
    "name": "Trust Bar",
    "blocks": [
      { "type": "item", "settings": { "icon": "shipping", "text": "Envío gratis +€49" } },
      { "type": "item", "settings": { "icon": "clock",    "text": "Entrega 2–4 días" } },
      { "type": "item", "settings": { "icon": "return",   "text": "30 días devolución" } },
      { "type": "item", "settings": { "icon": "shield",   "text": "Materiales certificados" } }
    ]
  }]
}
{% endschema %}
